/**
 * LLM subscriptions - builds the Google Form for the choice-based conjoint survey
 *
 * How to run (about 2 minutes, see survey/README.md):
 *   1. Go to https://script.google.com, signed in with the Google account that should own the form
 *   2. New project -> delete the sample code -> paste this whole file -> Save
 *   3. Choose the function "createForm" in the toolbar and click Run; allow the permissions
 *   4. Open View -> Logs (Execution log): it prints the link to send and the edit link
 *
 * Every run creates a NEW form and a new linked response spreadsheet; nothing is overwritten.
 *   PILOT = true   pilot version: "[PILOT]" in the title and a feedback section at the end
 *   PILOT = false  the real survey: run again once the pilot is done and the wording is final
 *
 * Data rules (README, "Survey protocol"):
 *   - every choice question is titled "Qk. ..." and is required
 *   - answers are stored as "Option A/B/C" (positions), never as brand names
 *   - everyone sees the same 13 questions in the same order: Q1-Q12 from the design and
 *     Q13, the holdout (answered by everyone, left out of the model, used to test its predictions)
 *   - nothing may change after the first real response
 *
 * The images and the DESIGN block below are generated by survey/make_survey_assets.py
 * from design_price_level/output/04_questionnaire_table.csv. Do not edit them by hand.
 */

const PILOT = true;

// Images are read from the public GitHub repository. If they cannot be downloaded,
// the plans are written as text under each question instead, and the log says so.
const IMAGE_BASE_URL =
  'https://raw.githubusercontent.com/martin-kri/Conjoint-Analysis-LLM-subscriptions/main/survey/images/';

const OPTIONS = ['Option A', 'Option B', 'Option C'];

// BEGIN DESIGN (generated by survey/make_survey_assets.py - do not edit)
const DESIGN = [
  {"q": 1, "holdout": false, "Assistant": ["Gemini", "Claude", "ChatGPT"], "Price": ["EUR 20.99 / month", "EUR 7.99 / month", "Free (EUR 0)"], "Usage": ["4x the free version", "10x the free version", "Same as today's free version"], "Included extras": ["Cloud storage + music & video streaming", "Cloud storage", "Nothing extra"]},
  {"q": 2, "holdout": false, "Assistant": ["ChatGPT", "Claude", "Gemini"], "Price": ["EUR 20.99 / month", "EUR 7.99 / month", "EUR 20.99 / month"], "Usage": ["Same as today's free version", "4x the free version", "10x the free version"], "Included extras": ["Cloud storage", "Cloud storage + music & video streaming", "Nothing extra"]},
  {"q": 3, "holdout": false, "Assistant": ["Claude", "ChatGPT", "Gemini"], "Price": ["EUR 7.99 / month", "EUR 20.99 / month", "EUR 7.99 / month"], "Usage": ["Same as today's free version", "10x the free version", "4x the free version"], "Included extras": ["Cloud storage", "Cloud storage + music & video streaming", "Nothing extra"]},
  {"q": 4, "holdout": false, "Assistant": ["Gemini", "Claude", "ChatGPT"], "Price": ["Free (EUR 0)", "EUR 20.99 / month", "EUR 7.99 / month"], "Usage": ["Same as today's free version", "10x the free version", "4x the free version"], "Included extras": ["Nothing extra", "Cloud storage + music & video streaming", "Cloud storage"]},
  {"q": 5, "holdout": false, "Assistant": ["ChatGPT", "Gemini", "Claude"], "Price": ["EUR 20.99 / month", "EUR 7.99 / month", "EUR 7.99 / month"], "Usage": ["4x the free version", "10x the free version", "Same as today's free version"], "Included extras": ["Cloud storage", "Cloud storage + music & video streaming", "Nothing extra"]},
  {"q": 6, "holdout": false, "Assistant": ["Gemini", "ChatGPT", "Claude"], "Price": ["EUR 7.99 / month", "EUR 20.99 / month", "Free (EUR 0)"], "Usage": ["4x the free version", "10x the free version", "Same as today's free version"], "Included extras": ["Nothing extra", "Nothing extra", "Cloud storage"]},
  {"q": 7, "holdout": false, "Assistant": ["ChatGPT", "Gemini", "Claude"], "Price": ["EUR 7.99 / month", "EUR 7.99 / month", "Free (EUR 0)"], "Usage": ["Same as today's free version", "10x the free version", "4x the free version"], "Included extras": ["Cloud storage + music & video streaming", "Cloud storage", "Nothing extra"]},
  {"q": 8, "holdout": false, "Assistant": ["Gemini", "Claude", "ChatGPT"], "Price": ["EUR 20.99 / month", "EUR 7.99 / month", "EUR 7.99 / month"], "Usage": ["4x the free version", "Same as today's free version", "10x the free version"], "Included extras": ["Cloud storage", "Cloud storage + music & video streaming", "Nothing extra"]},
  {"q": 9, "holdout": false, "Assistant": ["Claude", "ChatGPT", "Gemini"], "Price": ["EUR 20.99 / month", "EUR 7.99 / month", "EUR 20.99 / month"], "Usage": ["10x the free version", "Same as today's free version", "4x the free version"], "Included extras": ["Cloud storage", "Nothing extra", "Cloud storage + music & video streaming"]},
  {"q": 10, "holdout": false, "Assistant": ["Claude", "Gemini", "ChatGPT"], "Price": ["EUR 7.99 / month", "Free (EUR 0)", "EUR 20.99 / month"], "Usage": ["4x the free version", "Same as today's free version", "4x the free version"], "Included extras": ["Nothing extra", "Cloud storage", "Cloud storage + music & video streaming"]},
  {"q": 11, "holdout": false, "Assistant": ["ChatGPT", "Gemini", "Claude"], "Price": ["EUR 7.99 / month", "EUR 7.99 / month", "Free (EUR 0)"], "Usage": ["10x the free version", "Same as today's free version", "4x the free version"], "Included extras": ["Cloud storage + music & video streaming", "Cloud storage", "Nothing extra"]},
  {"q": 12, "holdout": false, "Assistant": ["Claude", "ChatGPT", "Gemini"], "Price": ["EUR 7.99 / month", "Free (EUR 0)", "EUR 7.99 / month"], "Usage": ["10x the free version", "4x the free version", "Same as today's free version"], "Included extras": ["Nothing extra", "Cloud storage", "Cloud storage + music & video streaming"]},
  {"q": 13, "holdout": true, "Assistant": ["Gemini", "Claude", "ChatGPT"], "Price": ["EUR 20.99 / month", "Free (EUR 0)", "EUR 7.99 / month"], "Usage": ["4x the free version", "Same as today's free version", "4x the free version"], "Included extras": ["Cloud storage + music & video streaming", "Nothing extra", "Nothing extra"]}
];
// END DESIGN

const INTRO = [
  'Imagine that from next month you choose ONE AI assistant plan, mainly for your studies or work.',
  'In each of the following 13 questions you will see three plans. Some are free, some are paid.',
  "Usage is described as providers do: as a multiple of what today's free version allows.",
  'Some plans do not exist today. Plans differ only in the characteristics shown.',
  'Please choose the plan you would really pick.'
].join('\n');

const ABOUT =
  'This survey is part of a student project for the course Laboratory of Customer and Business ' +
  'Analytics at the University of Trento. It takes about 5-7 minutes and is anonymous: we do not ' +
  'collect names or email addresses. There are no right or wrong answers.';

function createForm() {
  if (DESIGN.length !== 13) throw new Error('DESIGN must have 13 questions: run survey/make_survey_assets.py first.');

  const title = (PILOT ? '[PILOT] ' : '') + 'Choosing an AI assistant plan';
  const form = FormApp.create(title);
  form.setDescription(
    (PILOT ? 'PILOT VERSION: please answer as if it were the real survey; at the end we ask for your feedback.\n\n' : '') +
    ABOUT + '\n\n' + INTRO);
  form.setProgressBar(true);
  form.setCollectEmail(false);
  form.setAllowResponseEdits(false);
  form.setShowLinkToRespondAgain(false);
  form.setShuffleQuestions(false);
  form.setConfirmationMessage('Thank you! Your answers have been recorded.');

  // ---- 13 choice questions (Q13 = holdout), one page each, same look -------
  const missingImages = [];
  DESIGN.forEach(function (d) {
    const q = d.q;
    form.addPageBreakItem().setTitle('Question ' + q + ' of ' + DESIGN.length);

    const blob = fetchImage_(q);
    if (blob) {
      form.addImageItem()
        .setImage(blob)
        .setAlignment(FormApp.Alignment.CENTER)
        .setWidth(740);
    } else {
      missingImages.push(q);
    }

    const item = form.addMultipleChoiceItem()
      .setTitle('Q' + q + '. Which plan would you choose?')
      .setChoiceValues(OPTIONS)
      .setRequired(true);
    item.setHelpText(blob ? 'Look at the three plans in the table above and pick one.' : planText_(d));
  });

  // ---- Profile questions -----------------------------------------------
  form.addPageBreakItem()
    .setTitle('About you')
    .setHelpText('A few questions about how you use AI assistants. They help us compare groups of respondents.');

  form.addCheckboxItem()
    .setTitle('Which AI assistants have you used in the last month?')
    .setHelpText('Select all that apply.')
    .setChoiceValues(['ChatGPT', 'Gemini', 'Claude', 'Microsoft Copilot', 'Perplexity', 'DeepSeek',
      'Mistral Le Chat', 'A local model on my own computer (e.g. Ollama, LM Studio)',
      'None in the last month'])
    .showOtherOption(true)
    .setRequired(true);

  const mainChoices = ['ChatGPT', 'Gemini', 'Claude', 'Microsoft Copilot', 'Other',
    'I do not use an AI assistant for this'];
  form.addMultipleChoiceItem()
    .setTitle('Which AI assistant do you use most for your studies or work?')
    .setChoiceValues(mainChoices).setRequired(true);
  form.addMultipleChoiceItem()
    .setTitle('Which AI assistant do you use most in everyday life (outside studies or work)?')
    .setChoiceValues(mainChoices).setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle('Do you currently have a paid or discounted AI assistant plan?')
    .setChoiceValues(['No, I only use free versions', 'Yes, at full price',
      'Yes, with a student discount', 'Yes, free through a trial or promotion'])
    .setRequired(true);

  form.addCheckboxItem()
    .setTitle('If yes, which plan(s)?')
    .setHelpText('Skip this question if you do not have one.')
    .setChoiceValues(['ChatGPT Go', 'ChatGPT Plus or Pro', 'Google AI Plus', 'Google AI Pro or Ultra',
      'Claude Pro or Max', 'Microsoft Copilot Pro / Microsoft 365 with Copilot', 'Perplexity Pro'])
    .showOtherOption(true)
    .setRequired(false);

  form.addMultipleChoiceItem()
    .setTitle('In the past, have you had a free or discounted student plan for an AI assistant?')
    .setChoiceValues(['No', 'Yes, and it is still active', 'Yes, and afterwards I kept paying for the same plan',
      'Yes, and afterwards I switched to another paid plan', 'Yes, and afterwards I went back to free versions'])
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle("How often do you hit the usage limit of a free version?")
    .setChoiceValues(['Never', 'Sometimes', 'Often', 'I do not use free versions'])
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle('Are you currently...')
    .setChoiceValues(['Studying', 'Working', 'Both studying and working', 'Neither'])
    .setRequired(true);

  form.addListItem()
    .setTitle('If you study: what is your field of study?')
    .setChoiceValues(['Data science, statistics or mathematics', 'Computer science or engineering',
      'Economics, business or management', 'Natural sciences', 'Medicine or health sciences',
      'Law', 'Social or political sciences', 'Humanities, languages or arts', 'Other field',
      'I do not study'])
    .setRequired(true);

  form.addListItem()
    .setTitle('If you study: which degree are you enrolled in?')
    .setChoiceValues(["Bachelor's, 1st year", "Bachelor's, 2nd year", "Bachelor's, 3rd year or later",
      "Master's, 1st year", "Master's, 2nd year or later", 'Single-cycle degree', 'PhD', 'Other',
      'I do not study'])
    .setRequired(true);

  form.addTextItem()
    .setTitle('How old are you?')
    .setValidation(FormApp.createTextValidation()
      .setHelpText('Please enter your age in years (16-99).')
      .requireNumberBetween(16, 99).build())
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle('What is your gender?')
    .setChoiceValues(['Female', 'Male', 'Non-binary', 'Prefer not to say'])
    .setRequired(true);

  // ---- Pilot feedback (pilot version only) --------------------------------
  if (PILOT) {
    form.addPageBreakItem()
      .setTitle('Pilot feedback')
      .setHelpText('You are one of the first people to see this survey. Your feedback helps us fix it before we send it out.');
    form.addTextItem()
      .setTitle('About how many minutes did the survey take you?')
      .setValidation(FormApp.createTextValidation().requireNumberBetween(1, 120)
        .setHelpText('A number of minutes, please.').build())
      .setRequired(true);
    form.addMultipleChoiceItem()
      .setTitle('Which device did you use?')
      .setChoiceValues(['Phone', 'Computer', 'Tablet']).setRequired(true);
    form.addMultipleChoiceItem()
      .setTitle('Were the tables with the three plans easy to read on your screen?')
      .setChoiceValues(['Yes', 'Readable, but the text was small', 'No, hard to read']).setRequired(true);
    form.addMultipleChoiceItem()
      .setTitle('Was the introduction clear?')
      .setChoiceValues(['Yes', 'Partly', 'No']).setRequired(true);
    form.addMultipleChoiceItem()
      .setTitle('Was it clear what "4x" or "10x the free version" means?')
      .setChoiceValues(['Yes', 'Partly', 'No']).setRequired(true);
    form.addCheckboxItem()
      .setTitle('How did you mostly decide?')
      .setHelpText('Select all that apply.')
      .setChoiceValues(['I compared all four characteristics', 'Mostly by price',
        'Mostly by assistant', 'Mostly by usage', 'Mostly by extras',
        'Sometimes I picked without really comparing'])
      .setRequired(true);
    form.addParagraphTextItem()
      .setTitle('Did any question feel strange, unrealistic, too easy or impossible to answer? Which one and why?');
    form.addParagraphTextItem()
      .setTitle('Anything else that was unclear or that we should change?');
  }

  // ---- Response spreadsheet and links -------------------------------------
  const ss = SpreadsheetApp.create(title + ' (responses)');
  form.setDestination(FormApp.DestinationType.SPREADSHEET, ss.getId());
  form.setAcceptingResponses(true);
  try { if (typeof form.setPublished === 'function') form.setPublished(true); } catch (e) { /* older API */ }

  const url = form.getPublishedUrl();
  let shortUrl = url;
  try { shortUrl = form.shortenFormUrl(url); } catch (e) { /* keep the long link */ }

  Logger.log('Form created: ' + title);
  Logger.log('Link to send to respondents: ' + shortUrl);
  Logger.log('Edit link (team only):       ' + form.getEditUrl());
  Logger.log('Response spreadsheet:        ' + ss.getUrl());
  if (missingImages.length) {
    Logger.log('WARNING: images for questions ' + missingImages.join(', ') +
      ' could not be downloaded from ' + IMAGE_BASE_URL +
      '. Those questions show the plans as text instead. Push survey/images to GitHub and run again.');
  }
}

function fetchImage_(q) {
  const name = 'Q' + (q < 10 ? '0' : '') + q + '.png';
  try {
    const resp = UrlFetchApp.fetch(IMAGE_BASE_URL + name, { muteHttpExceptions: true });
    if (resp.getResponseCode() !== 200) return null;
    return resp.getBlob().setName(name);
  } catch (e) {
    return null;
  }
}

// Text version of a question, used only if its image is missing
function planText_(d) {
  return OPTIONS.map(function (o, i) {
    return o + ': ' + d['Assistant'][i] + ' | ' + d['Price'][i] + ' | Usage: ' + d['Usage'][i] +
      ' | Extras: ' + d['Included extras'][i];
  }).join('\n');
}
